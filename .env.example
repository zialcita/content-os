# --- App ---
# Legacy demo only. Production is deliberately refused until v6 wiring is complete.
APP_ENV=development
RUNTIME_MODE=simulation
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Data ---
DATABASE_URL=postgresql+psycopg://contentos:contentos@localhost:5432/contentos
REDIS_URL=redis://localhost:6379/0
# No live spending authority. Even a demo needs an explicitly chosen fixture cap.
SPEND_LIMIT_USD=0

# --- LLM (OpenAI-compatible, model-agnostic) ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Avatar / A-roll (HeyGen) ---
AVATAR_ENGINE=simulated
HEYGEN_API_KEY=
HEYGEN_API_BASE=https://api.heygen.com

# --- B-roll (library → Pexels → Higgsfield) ---
BROLL_ENGINE=simulated
PEXELS_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai

# --- Assembly (Shotstack) ---
ASSEMBLY_ENGINE=simulated
SHOTSTACK_API_KEY=
SHOTSTACK_API_BASE=https://api.shotstack.io
SHOTSTACK_ENV=stage

# --- Storage (Cloudflare R2 via S3 API, or local ./data) ---
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto

# --- YouTube / Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Scheduler ---
SCHEDULER_INTERVAL_SECONDS=60
SIMULATED_JOB_DELAY_SECONDS=0
